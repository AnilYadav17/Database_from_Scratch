# MYSQL PRACTICAL 15
==================================================

==================================================
1. NOT NULL Constraint
==================================================

CREATE TABLE employee (
    id INT,
    name VARCHAR(20) NOT NULL,
    salary DECIMAL(20, 2)
);

INSERT INTO employee VALUES (101, 'null', 50000);
INSERT INTO employee VALUES (103, '', 50000);
-- Invalid
-- INSERT INTO employee VALUES (102, NULL, 50000);


==================================================
2. UNIQUE Constraint
==================================================

CREATE TABLE employee1 (
    id INT,
    email VARCHAR(20) UNIQUE
);

INSERT INTO employee1 VALUES (101, 'ay@gmail.com');
-- Invalid
-- INSERT INTO employee1 VALUES (102, 'ay@gmail.com');


==================================================
3. UNIQUE Constraint on Multiple Columns
==================================================

CREATE TABLE employee2 (
    id INT,
    deptid INT,
    employeecode VARCHAR(20),
    CONSTRAINT uk_dept UNIQUE (deptid, employeecode)
);

INSERT INTO employee2 VALUES (101, 501, '401');
INSERT INTO employee2 VALUES (101, 501, '402');
INSERT INTO employee2 VALUES (101, 502, '401');
-- Invalid
-- INSERT INTO employee2 VALUES (101, 502, '401');


==================================================
4. UNIQUE vs NOT NULL
==================================================

CREATE TABLE employee3 (
    id INT,
    email VARCHAR(20) UNIQUE NOT NULL
);


==================================================
5. CHECK Constraint
==================================================

CREATE TABLE employee6 (
    id INT,
    name VARCHAR(20),
    age INT CHECK (age >= 18)
);

INSERT INTO employee6 VALUES (101, 'Anil', 19);
-- Invalid
-- INSERT INTO employee6 VALUES (102, 'Abhi', 16);


==================================================
6. CHECK Constraint with IN
==================================================

CREATE TABLE employee7 (
    id INT,
    name VARCHAR(20),
    dno INT CHECK (dno IN (10, 20, 30))
);

-- Invalid
-- INSERT INTO employee7 VALUES (101, 'Anil', 40);


==================================================
7. CHECK Constraint with Multiple Conditions
==================================================

CREATE TABLE employee9 (
    id INT,
    name VARCHAR(20),
    age INT,
    salary DECIMAL(10, 2),
    CHECK (age >= 18 AND salary >= 10000)
);

INSERT INTO employee9 VALUES (102, 'Abhi', 19, 19000);
-- Invalid
-- INSERT INTO employee9 VALUES (101, 'Anil', 17, 9000);


==================================================
8. CHECK Constraint with BETWEEN
==================================================

CREATE TABLE employee10 (
    id INT,
    name VARCHAR(20),
    marks INT,
    CHECK (marks BETWEEN 0 AND 100)
);

INSERT INTO employee10 VALUES (101, 'Anii', 100);
-- Invalid
-- INSERT INTO employee10 VALUES (101, 'Anii', 101);


==================================================
9. CHECK Constraint with Complex Logic
==================================================

CREATE TABLE employee11 (
    id INT,
    salary INT,
    ex INT,
    CHECK ((salary >= 15000 AND ex < 2) OR (ex > 2 AND salary >= 25000))
);
