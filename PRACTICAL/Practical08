==================================================
4. TIMESTAMP TYPE
==================================================

CREATE TABLE employeedt1(
    id INT, 
    name VARCHAR(20), 
    createdate TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

DESC employeedt1;

SELECT CURRENT_TIMESTAMP;
-- Output: 2026-08-17 17:18:53

INSERT INTO employeedt1 (id, name) VALUES (1011, 'Sneha');

SELECT * FROM employeedt1;
-- Output: 1011 | Sneha | 2026-08-17 17:21:25


==================================================
5. TIMESTAMP ON UPDATE
==================================================

CREATE TABLE employeedt3(
    id INT, 
    name VARCHAR(20), 
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DESC employeedt3;

INSERT INTO employeedt3 (id, name) VALUES (101, 'deepika');

SELECT * FROM employeedt3;

UPDATE employeedt3 SET name = 'deepika padukone' WHERE id = 101;

SELECT * FROM employeedt3;


