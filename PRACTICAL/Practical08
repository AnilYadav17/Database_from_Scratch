## 1. DATE TYPE

CREATE TABLE employeedt(
    id INT, 
    name VARCHAR(20), 
    birthdate DATE
);

DESC employeedt;

INSERT INTO employeedt VALUES (101, 'deepika', '1978-08-03');

SELECT * FROM employeedt;
-- Output: 101 | deepika | 1978-08-03


