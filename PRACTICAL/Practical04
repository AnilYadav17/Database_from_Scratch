==================================================
8. AUTO_INCREMENT WITH NULL
==================================================

Explanation:
NULL allows AUTO_INCREMENT to generate the ID.


CREATE TABLE employee5(
    sid INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(20),
    age INT
);


INSERT INTO employee5(name,age)
VALUES('Anil',22);

INSERT INTO employee5
VALUES(NULL,'Abhi',22);


SELECT * FROM employee5;

Output:

+-----+------+------+
| sid | name | age  |
+-----+------+------+
| 1   | Anil | 22   |
| 2   | Abhi | 22   |
+-----+------+------+



