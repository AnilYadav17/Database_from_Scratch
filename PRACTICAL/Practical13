==================================================
1. Delete all employees who belong to HR department
==================================================

DELETE FROM employeeup WHERE department = 'HR';


==================================================
2. Delete IT employees having more than 3 years of experience
==================================================

DELETE FROM employeeup WHERE department = 'IT' AND experience > 3;


==================================================
3. Delete employees who are not from IT or HR
==================================================

DELETE FROM employeeup WHERE department NOT IN ('IT', 'HR');


