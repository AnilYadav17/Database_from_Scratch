# MYSQL PRACTICAL 14
==================================================

==================================================
1. Rollback to Savepoint
==================================================

START TRANSACTION;

UPDATE orders SET orderstatus = 'Confirmed' WHERE oderid = 102;

SAVEPOINT orderconfirmed;

UPDATE orders SET amount = amount - 5000 WHERE oderid = 102;

ROLLBACK TO SAVEPOINT orderconfirmed;

COMMIT;


==================================================
2. Release Savepoint
==================================================

START TRANSACTION;

UPDATE orders SET orderstatus = 'Confirmed' WHERE oderid = 102;

SAVEPOINT orderconfirmed;

UPDATE orders SET amount = amount - 5000 WHERE oderid = 102;

RELEASE SAVEPOINT orderconfirmed;

COMMIT;


==================================================
3. Check and Set Autocommit
==================================================

SELECT @@autocommit;

SHOW VARIABLES LIKE 'autocommit';

SET AUTOCOMMIT = 0;

UPDATE orders SET amount = amount + 500 WHERE oderid = 101;

COMMIT;
